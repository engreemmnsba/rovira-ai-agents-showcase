# Template only — real values go in .env, which is never committed to git
# (see .gitignore). Create the real .env directly on the droplet, once,
# via the DigitalOcean Web Console — don't copy it through GitHub.

NODE_ENV=production

# Owner profile defaults (src/database/operations.js)
OWNER_EMAIL=
OWNER_WHATSAPP=

# Anthropic (Claude API) — used for proposal drafting and the Telegram bot's
# conversation.
ANTHROPIC_API_KEY=
# Optional — overrides the default model.
# ANTHROPIC_MODEL=

# Firebase
FIREBASE_PROJECT_ID=
# firebase-key.json (the service account key) is a SEPARATE file, also
# .gitignore'd — copy it onto the droplet directly, next to this .env, not
# through git.

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (Meta Cloud API) alerts
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
USER_WHATSAPP=
WHATSAPP_ALERT_NUMBER=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES_AT=

# Freelancer.com
FREELANCER_API_TOKEN=

# Freelance Search Agent polling interval — leave unset to use the default
# in FreelanceSearchAgent.js.
# SEARCH_INTERVAL=

# Instagram (Instagram API with Instagram Login — no Facebook Page needed).
# See docs/INSTAGRAM_SETUP.md. INSTAGRAM_ACCESS_TOKEN / INSTAGRAM_USER_ID /
# INSTAGRAM_TOKEN_EXPIRES_AT are written for you by: node src/instagram-auth.js
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN_EXPIRES_AT=

# OpenAI — gpt-image-1, used by InstagramContentAgent to generate real
# images for each post. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# imgbb — free public image hosting (no card needed) so a generated image
# has a public URL Instagram's API can fetch. Get a key at https://api.imgbb.com/
IMGBB_API_KEY=

# "سعد" — WhatsApp customer agent (docs: private)
SAAD_WA_TOKEN=
SAAD_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_WEBHOOK_PORT=3005
# Google Sheet every customer question is logged to (share it with the
# firebase-key.json service account email as Editor; /sheet shows it)
SAAD_SHEET_ID=

# Facebook page — approved Instagram posts are also published here
FB_PAGE_ID=
FB_PAGE_TOKEN=
